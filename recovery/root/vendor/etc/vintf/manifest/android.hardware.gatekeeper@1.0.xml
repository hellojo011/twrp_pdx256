<!--
    pdx256 자체 gatekeeper 는 AIDL (android.hardware.gatekeeper-service-qti) 입니다.
    pineapple 변형이 쓰던 HIDL @1.0::IGatekeeper 선언과 다릅니다.
-->
<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <version>1</version>
        <fqname>IGatekeeper/default</fqname>
    </hal>
</manifest>
