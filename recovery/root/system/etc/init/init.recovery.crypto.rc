# TWRP 에서 keymint HAL 을 띄워 /data 를 복호화하기 위한 init 스크립트.

on init
    # -- 링커 --------------------------------------------------------------
    # 리커버리 링커 설정(/system/etc/ld.config.txt)은
    #   namespace.default.search.paths = /system/${LIB}
    # 뿐이라 /vendor/lib64 를 보지 않습니다. 그러면 vendor 바이너리가 TWRP 의
    # libc++.so(754KB)를 물고 죽습니다:
    #   cannot locate symbol "_ZNSt3__122__libcpp_verbose_abortEPKcz"
    # 순정 libc++.so(1083KB)에만 있는 심볼입니다. 서비스별 LD_LIBRARY_PATH 로
    # /vendor/lib64 를 먼저 보게 합니다 (namespace 가 isolated=false 라 동작).
    #
    # -- SELinux -----------------------------------------------------------
    # u:r:qseecomd:s0 / u:r:vendor_keymint:s0 은 TWRP 정책에 없습니다.
    # 기기에서 확인: runcon u:r:qseecomd:s0 -> "Invalid argument".
    # 없는 도메인을 seclabel 로 지정하면 init 이 exec 도 소켓 생성도 실패합니다:
    #   init: cannot setexeccon('u:r:qseecomd:s0'): Invalid argument
    #   init: Could not create socket 'notify-topology': setsockcreatecon failed
    #   init: Service 'vendor.qseecomd' exited with status 6
    # 소켓이 없으면 qseecomd 는 곧바로 255 로 종료합니다.
    # u:r:recovery:s0 는 존재하고 permissive 로 동작하는 것을 확인했습니다.
    mkdir /vendor/firmware_mnt 0771 root system
    mkdir /mnt/vendor 0771 root system
    mkdir /mnt/vendor/persist 0771 root system

    # keymaster TA 는 GUID 이름으로 modem 파티션 안에 있습니다
    # (/vendor/firmware_mnt/image/05B04A44-....mdt 등).
    wait /dev/block/by-name/modem${ro.boot.slot_suffix} 10
    mount vfat /dev/block/by-name/modem${ro.boot.slot_suffix} /vendor/firmware_mnt ro


    # -- cpuset ------------------------------------------------------------
    # /dev/cpuset 는 마운트돼 있지만 하위 그룹이 하나도 없습니다. libprocessgroup
    # 의 task_profiles.json 이 이 경로들을 참조하므로 미리 만들어 둡니다.
    # (task_profiles.json 자체가 없어서 logd 가 죽던 문제는 램디스크에 파일을
    #  넣어 해결했습니다: system/etc/task_profiles.json)
    #   logd: libprocessgroup: Failed to find SCHED_SP_BACKGROUND task profile
    #   logd: failed to set background scheduling policy
    mkdir /dev/cpuset/foreground
    mkdir /dev/cpuset/background
    mkdir /dev/cpuset/system-background
    mkdir /dev/cpuset/top-app
    mkdir /dev/cpuset/restricted
    copy /dev/cpuset/cpus /dev/cpuset/foreground/cpus
    copy /dev/cpuset/mems /dev/cpuset/foreground/mems
    copy /dev/cpuset/cpus /dev/cpuset/background/cpus
    copy /dev/cpuset/mems /dev/cpuset/background/mems
    copy /dev/cpuset/cpus /dev/cpuset/system-background/cpus
    copy /dev/cpuset/mems /dev/cpuset/system-background/mems
    copy /dev/cpuset/cpus /dev/cpuset/top-app/cpus
    copy /dev/cpuset/mems /dev/cpuset/top-app/mems
    copy /dev/cpuset/cpus /dev/cpuset/restricted/cpus
    copy /dev/cpuset/mems /dev/cpuset/restricted/mems

    # persist 는 TZ 리스너(libdrmfs 등)가 쓰는 저장소입니다.
    wait /dev/block/by-name/persist 10
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist

    start vendor.qseecomd
    start vendor.keymint-qti

service vendor.qseecomd /vendor/bin/qseecomd
    socket notify-topology stream 660 system drmrpc
    class core
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64
    seclabel u:r:recovery:s0

service vendor.keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    class early_hal
    user root
    group root system drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64
    seclabel u:r:recovery:s0
