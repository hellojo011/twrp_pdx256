on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

# --- 복호화에 필요한 속성 교정 -------------------------------------------
#
# 1) vendor.gatekeeper.is_security_level_spu
#    순정의 /vendor/bin/init.qti.keymaster.sh 가 soc_id(618/639 = SM8750)를 보고
#    이 값을 0 으로 세웁니다. 리커버리엔 그 스크립트가 없어서 미설정으로 남고,
#    그러면 keymint HAL 이 초기화 후 등록하지 않고 futex 에서 멈춥니다.
#    (기기에서 이 값만 세워주니 곧바로 4개 인스턴스가 등록되는 것을 확인)
#
# 2) ro.build.version.security_patch
#    keymaster 패치 레벨/OS 버전 교정. 자세한 근거는 fix_patchlevel.sh 주석 참고.
#    (요약: 실제 값과 맞추는 대신 2099-12-31 / 16.1.0 으로 밀어올립니다 --
#     이 기기에서 복호화에 성공하는 TWRP 이미지가 쓰는 값입니다)
#    구 주석: 리커버리 값은 빌드 ID
#    (AP2A.240905.003)에서 온 2024-09-05 인데 기기 실제 값은 2026-06-01 이라
#    키 업그레이드가 필요해지고 거기서 실패합니다:
#      keystore2: utils.rs:315: Upgrade failed.
#      keystore2: Error::Km(r#INCOMPATIBLE_BLOCK_MODE)
#      recovery: keystore2 Keystore createOperation returned service specific error: -8
#    교정 후에는 shared secret negotiation 이 성공하고 keystore2 가 등록됩니다.
#
#    prepdecrypt.sh 의 SETPATCH 경로는 이 기기에서 쓸 수 없습니다 -- 동적
#    파티션이라 /dev/block/by-name/system 이 존재하지 않아 마운트가 실패합니다.
#    ro. 속성은 한 번 설정되면 setprop 으로 못 바꾸므로 resetprop 을 씁니다
#    (TW_INCLUDE_RESETPROP := true).
on init
    setprop vendor.gatekeeper.is_security_level_spu 0
    start fix_patchlevel

service fix_patchlevel /system/bin/fix_patchlevel.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
# ADSP 를 띄워 배터리 노드를 등록시킨다. 자세한 이유는 스크립트 주석 참고.
# post-fs 는 init.rc 의 late-init 에서 fs 다음으로 발동한다.
on post-fs
    start adsp_boot

service adsp_boot /system/bin/adsp_boot.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

# 발열 완화. 리커버리에는 thermal-engine / thermal HAL 이 없어서 커널 step_wise
# governor 만 동작한다. 그 상태에서 프라임 코어(policy6)가 메뉴 대기 중에도
# 2.8~3.5GHz 로 돈다. 상한을 2.0GHz 로 낮추면 60초 만에 실측으로
#   cpu-1-0-1  68.7C -> 52.5C
#   cpu-1-1-1  63.7C -> 53.2C
# 로 내려갔다. (커널이 가장 가까운 OPP 인 1958400 으로 맞춘다)
# 리커버리 작업은 대부분 I/O 바운드라 체감 성능 차이는 거의 없다.
# policy0(코어 0-5)은 대기 중 384MHz 까지 잘 내려가므로 건드리지 않는다.
on boot
    wait /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 10
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 2000000

# 진동 (Cirrus CS40L25A). 벤더 HAL 이 캘리브레이션을 Sony TA 에서 읽으므로
# TrimArea 데몬이 먼저 떠 있어야 한다. tad / wait4tad 는 순정 리커버리
# 이미지(recovery_X-FLASH-ALL-B083.img)의 /system/bin 에서 가져왔고,
# 서비스 정의도 순정 리커버리 init.rc 그대로다 (seclabel 만 다르다 -
# u:r:tad:s0 도메인이 이 정책에 없다).
# TA 노드의 소유자(oem_2997)와 권한은 vendor/etc/ueventd.rc 가 맞춰 준다.
on post-fs
    wait /dev/block/bootdevice/by-name/TA 5
    start tad
    start haptics_boot

service tad /system/bin/tad /dev/block/bootdevice/by-name/TA 0,16
    user oem_2997
    group oem_2997 root
    socket tad stream 0660 system oem_2993
    disabled
    seclabel u:r:recovery:s0

service haptics_boot /system/bin/haptics_boot.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
